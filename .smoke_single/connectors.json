{
  "version": 1,
  "connectors": [
    {
      "id": "modrinth",
      "name": "Modrinth",
      "base_url": "https://api.modrinth.com/v2",
      "description": "查询模组、版本、加载器与依赖。",
      "headers": {
        "User-Agent": "DarkittenModAgent/0.1 (mod development)"
      },
      "enabled": true,
      "builtin": true
    },
    {
      "id": "fabric-meta",
      "name": "Fabric Meta",
      "base_url": "https://meta.fabricmc.net/v2",
      "description": "查询 Fabric Loader、Yarn 映射与游戏版本。",
      "headers": {
        "User-Agent": "DarkittenModAgent/0.1"
      },
      "enabled": true,
      "builtin": true
    },
    {
      "id": "github",
      "name": "GitHub API",
      "base_url": "https://api.github.com",
      "description": "查询公开仓库、Release 与源码。令牌可选，用 ${GITHUB_TOKEN} 引用环境变量。",
      "headers": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "DarkittenModAgent/0.1"
      },
      "enabled": true,
      "builtin": true
    }
  ]
}
